{
  "name": "dsh-agent-run-logger",
  "version": "0.1.0",
  "description": "Local JSONL run traces for DeepSeek Harness sessions",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent-tracing",
    "agent-observability",
    "jsonl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluefateludi/dsh-agent-run-logger.git"
  },
  "homepage": "https://github.com/bluefateludi/dsh-agent-run-logger#readme",
  "bugs": {
    "url": "https://github.com/bluefateludi/dsh-agent-run-logger/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "vitest run --config vitest.config.ts",
    "pack:check": "pnpm pack --pack-destination dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
